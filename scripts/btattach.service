[Unit]
Description=Bluetooth HCI attach for AIC8800 (UART ttyS2)
Before=bluetooth.service bt-init.service
After=systemd-modules-load.service

[Service]
Type=simple
# btattach нельзя запускать, пока драйвер не загрузил BT-прошивку:
# в dmesg появляется строка "aicbsp: BT firmware ready" (~16-я секунда загрузки)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do dmesg | grep -qi "BT firmware ready" && break; sleep 1; done; rfkill unblock bluetooth || true'
ExecStart=/usr/bin/btattach -B /dev/ttyS2 -S 1500000 -P h4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
